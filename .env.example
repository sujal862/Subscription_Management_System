DATABASE_URL="file:./dev.db"
PORT=4000
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
NODE_ENV=development
# file = local .local/outbox email files; smtp = real email delivery
MAIL_MODE=file
MAIL_OUTBOX_DIR=.local/outbox
MAIL_FROM=Brightloop <demo@brightloop.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use true for STARTTLS (e.g. port 587). Production SMTP always requires TLS.
SMTP_REQUIRE_TLS=false
# Optional, explicit local administrator bootstrap; no account is created automatically.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
