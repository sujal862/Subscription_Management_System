{
  "name": "brightloop-subscription-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p client/tsconfig.json",
    "build": "tsc -p tsconfig.server.json && vite build --config client/vite.config.ts",
    "start": "node scripts/start.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/foundation.test.ts tests/catalog.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "nodemailer": "10.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "6.4.5"
  },
  "overrides": { "deepmerge-ts": "8.0.2" }
}
